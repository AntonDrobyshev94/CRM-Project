@{
    ViewData["Title"] = "Блог";
    Layout = "_Layout";
}
@model CompositeViewModel<BlogModel>
<link href="~/css/StyleSheet.css" rel="stylesheet" />
@{
    var blogModel = Model.ContentViewModel;
    string str = "https://localhost:7037/api/image/BlogModel/" + @blogModel.ImageName;
}
<div class="block">
    <div class="block-common">
        <h1>@blogModel.Name</h1>
        <div class="block-common-blog">
            <div class="block-common-logo">
                <a href="~/Blog/BlogPostDetails?id=@blogModel.Id">
                    <img style="width:450px" src=@str />
                </a>
            </div>
            <div class="block-header-title">
                <div class="blog-details">
                    <div class="blog-details-text">
                        <h3 class="blog-details-text-h3">@blogModel.BlogPost</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

