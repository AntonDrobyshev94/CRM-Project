@using Models.DataServiceModels;
@model SimpleViewModel
@{
    ViewData["Title"] = "Главная";
    Layout = "_Layout";
}

<link href="~/css/IndexStyle.css" rel="stylesheet" />
@{
    List<TagModel> tagModelList = ViewBag.TagModelList ?? new List<TagModel>();
    bool isEditMode = Model.LayoutViewModel.IsEditMode;
    string tittle = Model.LayoutViewModel.TitleModel.Title;
    string userName = Model.LayoutViewModel.IsAuth? Model.LayoutViewModel.UserName : "Аноним";
    if(userName.Equals("Аноним"))
    {
        Random rnd = new Random();
        int someNumber = rnd.Next(1, 1000);
        userName = "Аноним" + someNumber.ToString(); 
    }
}
<div class="block-index">
    <div class="form-picture-index">
        <a href="#">
            <img style="width:600px" src="https://localhost:7037/api/image/Application.png"/>
        </a>
    </div>
    @if (isEditMode)
    {
       @*  <div class="form-picture-index">
            <form action="~/Image/UploadAndSendImage" method="post" enctype="multipart/form-data" id="uploadForm">
                <input type="file" name="imageFile" accept="image/*" style="display: none;" id="uploadInput" />
                <input type="hidden" name="imageName" value="Application.png" />
                <label for="uploadInput" class="button-wrapper">
                    <img src="https://localhost:7037/api/image/editButton.png" alt="Редактировать" class="button-icon" />
                </label>
            </form>
        </div> *@
        <div class="form-tag">
            <table class="index-table">
                <thead>
                    <tr class="custom-table-header">
                        <th width="100">Текущий номер</th>
                        <th width="500">Текст тэга</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (TagModel tag in tagModelList)
                    {
                        <tr class="custom-table-cell">
                            <td>@Html.DisplayFor(modelItem => tag.Id)</td>
                            <td>@Html.DisplayFor(modelItem => tag.Tag)</td>
                            <td>
                                <input type="button" class="btn" value="Удалить" onclick="location.href='@Url.Action("DeleteTag", "Navigation", new { id = tag.Id})'" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <form method="post" class="index-table-form" id="AddTag" action="~/Navigation/AddTag">
                <input type="text" name="newTag" style="margin-right:10px"  value="" />
                <button class="styled-button" style ="width:200px" type="submit">Добавить тэг</button>
            </form>
        </div>
    }
@*     <script src="~/js/scripts.js"></script> *@
    <div class="form-container">
        <div class="request-form center">
            @if (isEditMode)
            {
                @if (tittle != null)
                {
                    <form method="post" style="margin-bottom:30px" id="saveMethod" action="~/Web/EditTitleMethod">
                        <input type="text" name="newTitle" value="@tittle" />
                        <button class="styled-button" style="margin-top:10px" type="submit">Сохранить</button>
                    </form>
                }
                else
                {
                    <form method="post" style="margin-bottom:30px" id="saveMethod" action="~/Web/EditTitleMethod">
                        <input type="text" name="newTitle" value="" />
                        <button class="styled-button" type="submit">Сохранить</button>
                    </form>
                }
            }
            else
            {
                @if (tittle != null)
                {
                    <h1 class="form-tittle">@tittle</h1>
                }
                else
                {
                    <h1 class="form-tittle"></h1>
                }
            }
            <form action="~/Web/AddRequest" method="post">
                <div class="form-fields">
                    <div class="form-fields">
                        <input type="text" placeholder="Имя" name="Name" />
                    </div>
                    <div class="form-fields">
                        <input type="text" placeholder="eMail" name="eMail" />
                    </div>
                </div>
                <textarea name="message" class="description" placeholder="Текст сообщения"></textarea>
                <input type="hidden" id="requestId" name="requestId"/>
                @if (TempData["RequestMessage"] != null && TempData["IsCorrectRequest"] != null)
                {
                    <div class="@((bool)TempData["IsCorrectRequest"]? "success" : "alert")">@TempData["RequestMessage"]</div>
                }
                <div class="form-buttons">
                    <input type="submit" class="styled-button" style="margin-left:2px;"  value="Подтвердить" />
                </div>
            </form>
        </div>
    </div>
</div>
<div class="container chat-container">
    <div>
        <div class="form-chat">Приветствуем @userName</div>
        <div><input type="hidden" id="currentUserName" value="@userName" /></div>
    </div>
    <div>
        <p></p>
        <div class="form-chat">Написать сообщение онлайн</div>
        <div>
            <div class="form-chat"><input type="text" id="messageInput" /></div>
        </div>
    </div>
    <div>
        <div>
            <input type="button" id="sendButton" value="Отправить сообщение" />
        </div>
    </div>
    <div>
        <div class="form-chatWindow">
            <div class="typing-indicator" id="typingIndicator"></div>
            <ul id="messagesList" class="message-list"></ul>
        </div>
    </div>
</div>
<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/chat.js"></script>
<script src="~/js/requestId_script.js"></script>
<audio id="buttonClickSound" src="sound/outgoingSoundMsg.mp3" preload="auto"></audio>
<audio id="incomingMessageSound" src="sound/incomingSoundMsg.mp3" preload="auto"></audio>
