@{
    ViewData["Title"] = "Добавление ссылки";
    Layout = "_Layout";
}
<link href="~/css/IndexStyle.css" rel="stylesheet" />
@model SimpleViewModel
@{
    var layoutModel = Model.LayoutViewModel;
    bool isAdmin = layoutModel.IsAdmin;
}

@if (isAdmin)
{
    <div class="form-container">
        <div class="request-form center">
            <div>
                <form action="~/Link/AddLink" method="post" enctype="multipart/form-data" id="uploadForm" data-redirect-url="/Contact/Contacts">
                    <input type="file" name="imageFile" accept="image/*" id="uploadInput" />
                    <label>Ссылка</label>
                    <input type="text" name="url" value="" /><br />
                    <p><input type="submit" style="margin-top:20px" class="styled-button" value="Добавить" /></p>
                </form>
            </div>
        </div>
    </div>
    <script src="~/js/exception_script.js"></script>
}