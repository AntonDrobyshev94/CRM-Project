@{
    ViewData["Title"] = "Изменение ссылки";
    Layout = "_Layout";
}
<link href="~/css/IndexStyle.css" rel="stylesheet" />
@model CompositeViewModel<LinkModel>
@{
    var layoutModel = Model.LayoutViewModel;
    var linkModel = Model.ContentViewModel;
    bool isAdmin = layoutModel.IsAdmin;
}
@if (isAdmin)
{
    <div class="form-container">

        <div class="request-form center">
            <div>
                <form action="~/Link/ChangeLink" method="post" enctype="multipart/form-data" id="uploadForm" data-redirect-url="/Contact/Contacts">
                    <input type="file" name="imageFile" accept="image/*" id="uploadInput" />
                    <input type="hidden" name="imageName" value="@linkModel.ImageName">
                    <input type="hidden" name="id" value="@linkModel.Id">
                    <label>Ссылка</label>
                    <input type="text" name="url" value="@linkModel.Url" /><br />
                    <p><input type="submit" style="margin-top:20px" class="styled-button" value="Подтвердить изменения" /></p>
                </form>
            </div>
        </div>
    </div>
    <script src="~/js/exception_script.js"></script>
}
