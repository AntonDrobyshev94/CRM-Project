@{
    ViewData["Title"] = "Изменение услуг";
    Layout = "_Layout";
}
<link href="~/css/IndexStyle.css" rel="stylesheet"/>
@model CompositeViewModel<Service>
@{
    var layoutModel = Model.LayoutViewModel;
    var serviceModel = Model.ContentViewModel;
    bool isAdmin = layoutModel.IsAdmin;
}
@if (isAdmin)
{
    <div class="form-container">
        <div class="request-form center">
            <div>
                <form action="~/Service/ChangeService" method="post">
                    <label>Название услуги</label><br />
                    <input type="text" name="name" value="@serviceModel.Name" /><br />
                    <label>Описание услуги</label><br />
                    <textarea name="description" rows="3" class="description">@serviceModel.Description</textarea><br /><br />
                    <input type="hidden" name="id" value="@serviceModel.Id">
                    <p><input type="submit" style="margin-top:20px" class="styled-button" value="Подтвердить изменения" /></p>
                </form>
            </div>
        </div>
    </div>
}
