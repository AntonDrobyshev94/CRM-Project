@{
    ViewData["Title"] = "Услуги";
    Layout = "_Layout";
}
@model CompositeViewNumerableModel<Service>
<link href="~/css/StyleSheet.css" rel="stylesheet" />
@{
    var layoutModel = Model.LayoutViewModel;
    var serviceModel = Model.ContentViewModel;
    bool isEditMode = layoutModel.IsEditMode;

}
<div class="block">
    <div class="block-container">
        <h1>Что мы можем сделать</h1>
        @if(serviceModel !=null)
        {
            @foreach (var service in serviceModel)
            {
                <div class="block-item">
                    <div class="block-title">@service.Name</div>
                    <div class="block-text">@service.Description</div>
                    @if (isEditMode)
                    {
                        <div class="form-button" style="height:40px; display: inline-block; margin-right: 10px">
                            <img src="https://localhost:7037/api/image/editButton.png" alt="Изменить" class="button-ic" onclick="location.href='@Url.Action("ChangeServiceWindow", "Service", new { id = service.Id})'" />
                        </div>
                        <div class="form-button" style="height:40px; display: inline-block; margin-right: 10px">
                            <img src="https://localhost:7037/api/image/delete.png" alt="Удалить" class="button-ic" onclick="location.href='@Url.Action("DeleteService", "Service", new { id = service.Id})'" />
                        </div>
                    }
                </div>
            }
        }

        @if(isEditMode)
        {
            <div class="form-button" style="height:40px">
                <a class="styled-button" href="~/Service/AddServiceWindow">Добавить услугу</a>
            </div>
        }
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src ="~/js/slider_script.js"></script>
