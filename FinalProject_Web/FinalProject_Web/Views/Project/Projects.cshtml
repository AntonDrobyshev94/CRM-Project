@{
    ViewData["Title"] = "Проекты";
    Layout = "_Layout";
}
@model CompositeViewNumerableModel<ProjectModel>
<link href="~/css/StyleSheet.css" rel="stylesheet" />
@{
    var layoutModel = Model.LayoutViewModel;
    var projectModel = Model.ContentViewModel;
    bool isEditMode = layoutModel.IsEditMode;
    string str = "";
}
<div class="block">
    <div class="block-header">
        <h1>Наши проекты</h1>
    </div>
    <div class="project-container">
            @if (projectModel!=null)
            {
                @foreach (var project in projectModel)
                {
                str = "https://localhost:7037/api/image/ProjectModel/" + project.ImageName;
                <div class="block-container-items">
                    <div class="block-container-project">
                        <div class="block-item-project">
                            <div class="form-picture-project">
                                <div class="form-picture-project-block">
                                    <a href="~/Project/ProjectDetails?id=@project.Id">
                                    <img src=@str/>
                                    </a>
                                </div>
                            </div>
                            <div class="block-text-project">@project.Name</div>
                        </div>
                    </div>
                    @if (isEditMode)
                    {
                        <div class="form-button" style="height:40px; display: inline-block; margin-left:15px; margin-right: 5px">
                            <img src="https://localhost:7037/api/image/editButton.png" alt="Изменить" class="button-ic" onclick="location.href='@Url.Action("ChangeProjectWindow", "Project", new { id = project.Id })'" />
                        </div>
                        <div class="form-button" style="height:40px; display: inline-block; margin-right: 10px">
                            <img src="https://localhost:7037/api/image/delete.png" alt="Удалить" class="button-ic" onclick="location.href='@Url.Action("DeleteProject", "Project", new { id = project.Id})'" />
                        </div>
                    }
                </div>
                }
            }
    </div>
</div>
<div class="block-footer">
    @if (isEditMode)
    {
        <div class="form-button" style="height:40px">
            <a class="styled-button" href="~/Project/AddProjectWindow">Добавить проект</a>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/slider_script.js"></script>