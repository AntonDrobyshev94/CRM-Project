@{
    ViewData["Title"] = "Изменение проекта";
    Layout = "_Layout";
}
<link href="~/css/IndexStyle.css" rel="stylesheet" />
@model CompositeViewModel<ProjectModel>
@{
    var layoutModel = Model.LayoutViewModel;
    var projectModel = Model.ContentViewModel;
    bool isAdmin = layoutModel.IsAdmin;
}
@if (isAdmin)
{
    <div class="form-container">

        <div class="request-form center">
            <div>
                <form action="~/Project/ChangeProject" method="post" enctype="multipart/form-data" id="uploadForm" data-redirect-url="/Project/Projects">
                    <input type="file" name="imageFile" accept="image/*" id="uploadInput"/>
                    <input type="hidden" name="imageName" value="@projectModel.ImageName">
                    <input type="hidden" name="id" value="@projectModel.Id">
                    <label>Название проекта</label>
                    <input type="text" name="name" value="@projectModel.Name" /><br />
                    <label>Описание проекта</label><br />
                    <textarea name="description" rows="3" class="description">@projectModel.Description</textarea><br /><br />
                    <p><input type="submit" style="margin-top:20px" class="styled-button" value="Подтвердить изменения" /></p>
                </form>
            </div>
        </div>
    </div>
    <script src="~/js/exception_script.js"></script>
}

