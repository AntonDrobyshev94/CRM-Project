@{
    ViewData["Title"] = "Добавление проектов";
    Layout = "_Layout";
}
<link href="~/css/IndexStyle.css" rel="stylesheet" />
@model SimpleViewModel
@{
    bool isAdmin = Model.LayoutViewModel.IsAdmin;
}

@if (isAdmin)
{
    <div class="form-container">
        <div class="request-form center">
            <div>
                <form action="~/Project/AddProject" method="post" enctype="multipart/form-data" id="uploadForm" data-redirect-url="/Project/Projects">
                    <input type="file" name="imageFile" accept="image/*" id="uploadInput" />
                    <label>Название проекта</label>
                    <input type="text" name="name" value="" /><br />
                    <label>Описание проекта</label><br />
                    <textarea name="description" rows="3" class="description"></textarea><br /><br />
                    <p><input type="submit" style="margin-top:20px" class="styled-button" value="Добавить" /></p>
                </form>
            </div>
        </div>
    </div>
    <script src="~/js/exception_script.js"></script>
}
